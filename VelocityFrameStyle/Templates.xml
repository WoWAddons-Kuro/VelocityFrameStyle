<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

	<!--
		VFS_SweepTextureTemplate: the Target danger sweep (SPECS/13). Copy of VelocityPlateStyle's
		VPS_SweepTextureTemplate with our asset path.

		Why XML: on Classic Era 1.15.9 the Lua TextureCoordTranslation animation object has NO offset
		setter (SetOffset / SetOffsetU are absent; VPS finding 2026-11-23), even though the generated API
		docs claim otherwise. offsetU/offsetV can only be given as XML attributes, exactly how Blizzard's
		stock nameplate aggro flare does it. Lua only sizes, colours, shows and plays it.

		offsetU="-1": one full tile travels left-to-right per cycle. duration is the speed knob.
	-->
	<Texture name="VFS_SweepTextureTemplate" virtual="true" hidden="true" alphaMode="BLEND"
	         file="Interface\AddOns\VelocityFrameStyle\Assets\leftgrad.tga" horizTile="true" vertTile="false">
		<Animations>
			<AnimationGroup parentKey="Sweep" looping="REPEAT">
				<TextureCoordTranslation duration="1.0" order="1" offsetU="-1" offsetV="0"/>
			</AnimationGroup>
		</Animations>
	</Texture>
</Ui>