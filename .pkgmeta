package-as: VelocityFrameStyle

# Packager-style repo: the addon lives one level down so the repo root can hold Scripts/ (C# asset generators),
# SPECS/, docs and icon sources without shipping them. publish.cmd discovers D\D\D.toc; release.cmd zips the same.
move-folders:
  VelocityFrameStyle/VelocityFrameStyle: VelocityFrameStyle

ignore:
  - ".git*"
  - "*.md"
  - SPECS
  - Scripts
  - Assets
  - .pkgmeta
  - "*.png"
  - "*.jpg"